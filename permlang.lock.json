{
  "permlang": 2,
  "functions": {
    ".github/workflows/permlang.yml#<permlang.yml>": [
      "ci.action(PermLang/permlang)",
      "ci.action(actions/checkout)",
      "ci.action(actions/setup-node)",
      "ci.action(actions/upload-artifact)",
      "ci.permission(contents: read)",
      "ci.permission(pull-requests: write)",
      "ci.trigger(merge_group)",
      "ci.trigger(pull_request)",
      "ci.trigger(push)",
      "ci.unpinned(PermLang/permlang)",
      "ci.unpinned(actions/checkout)",
      "ci.unpinned(actions/setup-node)",
      "ci.unpinned(actions/upload-artifact)"
    ],
    ".github/workflows/tests.yml#<tests.yml>": [
      "ci.action(actions/checkout)",
      "ci.action(actions/setup-node)",
      "ci.permission(contents: read)",
      "ci.trigger(pull_request)",
      "ci.trigger(push)",
      "ci.unpinned(actions/checkout)",
      "ci.unpinned(actions/setup-node)"
    ],
    "package.json#<package.json>": [
      "npm.script(permlang: permlang)",
      "npm.script(test: node --test \"test/**/*.test.ts\")",
      "npm.script(typecheck: tsc --noEmit)"
    ],
    "permlang.config.json#<permlang.config.json>": [
      "permlang.files(src)",
      "permlang.strictness(development)",
      "permlang.tools(warn)",
      "permlang.unmapped(warn)"
    ],
    "src/leads.ts#handleLead": [
      "env(HUBSPOT_TOKEN)",
      "fs.write(./data)",
      "fs.write(./data/leads.jsonl)",
      "net(api.hubspot.com)"
    ],
    "src/store.ts#saveLead": [
      "fs.write(./data)",
      "fs.write(./data/leads.jsonl)"
    ]
  },
  "unsafe": {}
}
